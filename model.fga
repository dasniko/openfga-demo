model
  schema 1.1

type user

type organization
  relations
    define admin: [user]
    define member: [user] or admin

    define can_create_project: admin

type project
  relations
    define organization: [organization]

    define editor: [user] or admin from organization
    define viewer: [user] or editor or member from organization

    define can_edit: editor
    define can_view: viewer
